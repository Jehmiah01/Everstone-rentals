{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "everstonerentals",
  "main": "dist/server/server.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "assets": { "directory": "./dist/client", "binding": "ASSETS", "not_found_handling": "none" },
  "d1_databases": [
    { "binding": "DB", "database_name": "everstone-rentals", "database_id": "f547c2a2-6e91-461d-8723-0661b3c483a5", "migrations_dir": "migrations" }
  ],
  "kv_namespaces": [{ "binding": "FILES", "id": "6c8bda93a34041cf808668e37ccf5eb7" }]
}
